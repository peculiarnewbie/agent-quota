{
  "name": "agent-quota-electron",
  "version": "1.0.0",
  "description": "Agent Quota – Electron desktop shell",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n vite,electron \"cd ../vite+bun && vite\" \"electron .\"",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['release','dist']) { try { fs.rmSync(p,{recursive:true,force:true}); } catch (error) { console.warn('[clean] skipped', p, error.code || error.message); } }\"",
    "start": "electron .",
    "pack": "bun run clean && electron-builder --win portable",
    "dist": "bun run clean && electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.agentquota.electron",
    "productName": "Agent Quota",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "assets/**/*",
      "src/lib/**/*"
    ],
    "extraResources": [
      {
        "from": "../vite+bun/dist",
        "to": "vite+bun/dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "installerHeaderIcon": "assets/app-icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Quota",
      "artifactName": "AgentQuota-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AgentQuota-Portable-${version}.exe"
    }
  }
}
