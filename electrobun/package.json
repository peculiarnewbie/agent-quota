{
	"name": "agent-quota",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "vite build && electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build": "vite build && electrobun build"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.2.0",
		"electrobun": "1.16.0",
		"solid-js": "^1.9.11",
		"tailwindcss": "^4.2.0",
		"vite": "^7.3.1",
		"vite-plugin-solid": "^2.11.10"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"concurrently": "^9.1.2"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
