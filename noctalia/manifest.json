{
    "id": "agent-quota",
    "name": "Agent Quota",
    "version": "1.0.0",
    "minNoctaliaVersion": "3.6.0",
    "author": "agent",
    "license": "MIT",
    "repository": "https://github.com/peculiarnewbie/agent-quota",
    "description": "AI API usage tracking for Claude, Codex, Zai, OpenCode Go, OpenRouter, Opencode Zen, and CroF AI",
    "entryPoints": {
        "main": "Main.qml",
        "barWidget": "BarWidget.qml",
        "panel": "Panel.qml",
        "settings": "Settings.qml"
    },
    "dependencies": {
        "plugins": []
    },
    "metadata": {
        "defaultSettings": {
            "refreshInterval": 300000,
            "barDisplayItems": ["claude-5h", "codex-5h", "zai"],
            "showPercentInBar": true,
            "trackClaude": true,
            "trackCodex": true,
            "trackZai": true,
            "trackOpencodeGo": true,
            "trackOpenRouter": true,
            "trackOpencodeZen": true,
            "trackCrofAI": true,
            "OPENROUTER_API_KEY": "",
            "CROF_AI_API_KEY": "",
            "CROF_AI_DAILY_LIMIT": "",
            "OPENCODE_API_KEY": "",
            "OPENCODE_GO_WORKSPACE_ID": "",
            "OPENCODE_GO_AUTH_COOKIE": "",
            "ZAI_API_KEY": "",
            "OPENAI_API_KEY": "",
            "CLAUDE_ACCESS_TOKEN": ""
        }
    }
}
